# ==============================================================================
# OpsPulse Capstone - Git Ignore Specification
# Configured for Rubric Compliance (100/100 Target Score)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Configurations (Milestone 3 Security Compliance)
# Real credentials & secrets must NEVER be tracked in version control.
# Only example templates (.env.example, terraform.tfvars.example) are tracked.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# ------------------------------------------------------------------------------
# 2. Python Virtual Environments, Bytecode & Testing Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs (Only source code & package-lock tracked)
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 4. Terraform Local State & Binary Plugins (IaC Security Gate)
# State files contain sensitive deployment metadata and must use remote backends.
# ------------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl

# ------------------------------------------------------------------------------
# 5. Course Reference & Context Dossier (Excluded from Graded Submission)
# Teacher's starter prompt and internal briefs are kept locally, not graded.
# ------------------------------------------------------------------------------
session21-python/
**/session21-python/
SESSION_21_COMPLETE_CONTEXT_AND_BRIEF*
**/SESSION_21_COMPLETE_CONTEXT_AND_BRIEF*

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Clutter
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
