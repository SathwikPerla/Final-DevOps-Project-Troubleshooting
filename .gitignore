# ==============================================================================
# SevZero SRE Platform - Git Ignore Specification
# Configured for Production Hygiene & Security Compliance
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Environment Configurations (Security Gate)
# Real credentials & secrets must NEVER be tracked in version control.
# Only example templates (.env.example, terraform.tfvars.example) are tracked.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# ------------------------------------------------------------------------------
# 2. Python Virtual Environments, Bytecode & Testing Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# 4. Terraform Local State & Binary Plugins (IaC Security Gate)
# ------------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.lock.hcl
crash.log

# ------------------------------------------------------------------------------
# 5. Internal Development Scripts, Prompts & Teleprompter Drafts
# ------------------------------------------------------------------------------
*teleprompter*
*TELEPROMPTER*
session21-python/
**/session21-python/
SESSION_21_COMPLETE_CONTEXT_AND_BRIEF*
**/SESSION_21_COMPLETE_CONTEXT_AND_BRIEF*

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Clutter
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.log
